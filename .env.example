# Clerk authentication (https://clerk.com)
# Create a free app at https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Clerk route configuration (defaults work with /sign-in and /sign-up routes)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Database — Neon Postgres (https://neon.tech)
# Free serverless Postgres. Create a project, copy the pooled connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional — Google Analytics
NEXT_PUBLIC_GA_ID=

# Optional — public site URL (used for canonical metadata)
NEXT_PUBLIC_SITE_URL=
